#!/bin/bash

set -e

cd $(dirname "$0")

final_retval=0

echo "Running ansible-lint to check playbook formatting..."
find playbooks -type f \( -name "*.yaml" -o -name "*.yml" \) -mindepth 1 -maxdepth 1 -print0 | xargs -0 ansible-lint
retval="$?"
if [ "$retval" -ne 0 ] && [ "$final_retval" -eq 0 ]; then
    final_retval="$retval"
fi

echo "Running ansible-lint to check task and handler formatting..."
find roles -type f \( -name "*.yaml" -o -name "*.yml" \) \( -path '*/tasks/*' -o -path '*/handlers/*' \) -mindepth 3 -print0 | xargs -0 ansible-lint
retval="$?"
if [ "$retval" -ne 0 ] && [ "$final_retval" -eq 0 ]; then
    final_retval="$retval"
fi

if [ "$final_retval" -eq 0 ]; then
    echo "SUCCESS!"
else
    echo "One or more playbooks or roles failed lint validation." >&2
fi

exit "$final_retval"
